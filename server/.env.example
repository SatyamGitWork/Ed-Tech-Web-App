# MongoDB Configuration
# For local development (if you have MongoDB installed locally):
MONGODB_URI=mongodb://localhost:27017/edtech

# For MongoDB Atlas (cloud database):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/edtech?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your_very_secure_random_secret_key_here

# Email Configuration (Gmail)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# Google Drive OAuth2 Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Google Drive Refresh Token (Get this after OAuth authorization)
# Visit http://localhost:5000/auth/google to authorize and get refresh token
GOOGLE_OAUTH_REFRESH_TOKEN=your_refresh_token_here

# Google Drive Folder IDs (Optional - will use 'root' if not specified)
# Create folders in your Google Drive and get their IDs from the URL
GOOGLE_DRIVE_VIDEOS_FOLDER_ID=folder_id_for_videos
GOOGLE_DRIVE_DOCUMENTS_FOLDER_ID=folder_id_for_documents
GOOGLE_DRIVE_IMAGES_FOLDER_ID=folder_id_for_images

# Client URL (for CORS)
CLIENT_URL=http://localhost:5000

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development
